# [APP] Next.js Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [AI - GEMINI]
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_PROJECT_ID=your_vertex_project_id

# [LMS - MOODLE]
MOODLE_URL=https://lms.deepb-aix.edu.vn
MOODLE_TEST_TOKEN=your_moodle_web_service_token

# [CRM - HUBSPOT]
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token

# [PAYMENT - AIRWALLEX / VNPAY]
